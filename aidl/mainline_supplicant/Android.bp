aidl_interface {
    name: "android.system.wifi.mainline_supplicant",
    unstable: true,
    imports: [
        "android.hardware.wifi.supplicant-V5",
        "android.hardware.wifi.common-V2",
    ],
    srcs: ["android/system/wifi/mainline_supplicant/*.aidl"],
    backend: {
        java: {
            enabled: true,
            sdk_version: "module_current",
            apex_available: [
                "//apex_available:platform",
                "com.android.wifi",
            ],
            min_sdk_version: "30",
            lint: {
                // Disable linter to avoid error about fixed size arrays.
                // Interface will only be accessed on devices >= B.
                enabled: false,
            },
        },
        ndk: {
            enabled: true,
            gen_trace: true,
            apex_available: [
                "//apex_available:platform",
                "com.android.wifi",
            ],
            min_sdk_version: "30",
        },
        cpp: {
            enabled: false,
        },
        rust: {
            enabled: false,
        },
    },
}
